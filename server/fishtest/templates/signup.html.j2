{% extends "base.html.j2" %}

{% block title %}Register | PointTest{% endblock %}

{% block body %}
<div class="col-limited-size">
  <header class="text-md-center py-2">
    <h2>Register</h2>
    <div class="alert alert-info">
      <h4 class="alert-heading">Instant Approval</h4>
      <p class="mb-0">New accounts are approved automatically.</p>
      <hr />
      <p class="mb-0">Already have an account? <strong><a href="/login" class="alert-link">Log in</a></strong></p>
    </div>
  </header>

  <form method="POST">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

    <div class="form-floating mb-3">
      <input
        type="text"
        class="form-control mb-3"
        id="username"
        name="username"
        placeholder="Username"
        pattern="{{ VALID_USERNAME_PATTERN }}"
        title="Only letters and digits and at least 2 long"
        required
        autofocus
      >
      <label for="username" class="d-flex align-items-end">Username</label>
    </div>

    <div class="input-group mb-3">
      <div class="form-floating">
        <input
          type="password"
          class="form-control"
          id="password"
          name="password"
          placeholder="Password"
          pattern=".{8,}"
          title="Eight or more characters: a password too simple or trivial to guess will be rejected"
          required
        >
        <label for="password" class="d-flex align-items-end">Password</label>
      </div>
      <span class="input-group-text toggle-password-visibility" role="button">
        <i class="fa-solid fa-lg fa-eye pe-none icon-fixed-width"></i>
      </span>
    </div>

    <div class="input-group mb-3">
      <div class="form-floating">
        <input
          type="password"
          class="form-control"
          id="password2"
          name="password2"
          placeholder="Repeat Password"
          required
        >
        <label for="password2" class="d-flex align-items-end">Repeat Password</label>
      </div>
      <span class="input-group-text toggle-password-visibility" role="button">
        <i class="fa-solid fa-lg fa-eye pe-none icon-fixed-width"></i>
      </span>
    </div>

    <div class="form-floating mb-3">
      <input
        type="email"
        class="form-control mb-3"
        id="email"
        name="email"
        placeholder="Email"
        required
      >
      <label for="email" class="d-flex align-items-end">Email</label>
    </div>

    <div class="input-group mb-3">
      <div class="form-floating">
        <input
          class="form-control"
          id="tests_repo"
          name="tests_repo"
          placeholder="GitHub PointChess fork URL"
        >
        <label for="tests_repo" class="d-flex align-items-end">Tests Repository</label>
      </div>
      <span class="input-group-text" role="button" data-bs-toggle="modal" data-bs-target="#tests_repo_info_modal">
        <i class="fas fa-question-circle fa-lg pe-none icon-fixed-width"></i>
      </span>
    </div>

    <div id="tests_repo_info_modal" class="modal fade" tabindex="-1" aria-labelledby="tests_repo_info_modal_label" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-body">
          This Github fork URL will be the default fork URL for users who want to contribute code when creating runs,
           it is not needed for resources contribution.
          </div>
        </div>
      </div>
    </div>

    <div class="mb-3">
      <label for="pointtest-slider" class="form-label">Human check: drag the slider into the <strong>green zone</strong></label>
      <input type="hidden" name="slider_token" value="{{ slider_token }}">
      <input type="hidden" name="slider_value" id="slider_value" value="">
      <input type="hidden" name="slider_time" id="slider_time" value="">
      <div class="position-relative px-1 py-2 border rounded bg-body-tertiary">
        <div id="slider_zone" class="position-absolute top-0 bottom-0 bg-success opacity-25 rounded" style="pointer-events:none;"></div>
        <input type="range" class="form-range" min="0" max="100" step="0.5" value="0" id="pointtest-slider">
      </div>
      <div class="form-text" id="slider_status">Slide to the green zone to prove you are human.</div>
    </div>
    <script>
      (function () {
        var target = {{ slider_target }};
        var slider = document.getElementById("pointtest-slider");
        var zone = document.getElementById("slider_zone");
        var status = document.getElementById("slider_status");
        var valField = document.getElementById("slider_value");
        var timeField = document.getElementById("slider_time");
        var start = null;
        zone.style.left = (target - 4) + "%";
        zone.style.width = "8%";
        slider.addEventListener("pointerdown", function () { start = Date.now(); }, { once: true });
        slider.addEventListener("input", function () {
          var v = parseFloat(slider.value);
          valField.value = v;
          timeField.value = start ? Date.now() - start : 0;
          if (Math.abs(v - target) <= 2) {
            status.textContent = "Good, you look human. You can register now.";
          } else {
            status.textContent = "Keep sliding into the green zone.";
          }
        });
      })();
    </script>

    <button type="submit" class="btn btn-primary w-100">Register</button>
  </form>
</div>

<script src="{{ static_url('fishtest:static/js/toggle_password.js') }}"></script>
{% endblock %}
